# xSignalRelay on the server: copy to .env next to compose.yml (chmod 600). FASTSIGNAL_TAG is written by deploy.sh.
FASTSIGNAL_HOST=fastsignal.<domain>
FASTSIGNAL_IMAGE_PREFIX=git.<domain>/xauto
FASTSIGNAL_TAG=
# Key of the client (X-Api-Key), e.g. openssl rand -hex 24; entered once in the app settings
RELAY_API_KEY=
# Archives kept in backups/ (the oldest are removed)
KEEP_BACKUPS=10
